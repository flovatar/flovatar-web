APP_NAME=Flovatar
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1
TELESCOPE_ENABLED=false

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

MIX_ACCESS_NODE=https://rest-mainnet.onflow.org
MIX_WALLET_DISCOVERY=https://flow-wallet.blocto.app/authn
MIX_CONTRACT_FUNGIBLE=0xf233dcee88fe0abe
MIX_CONTRACT_NON_FUNGIBLE=0x1d7e57aa55817448
MIX_CONTRACT_FLOW_TOKEN=0x1654653399040a61
MIX_CONTRACT_FIND=0x097bafa4e0b48eef
MIX_METADATA_VIEWS=0x1d7e57aa55817448
MIX_CONTRACT_STOREFRONT=0x4eb8a10cb9f87357
MIX_CONTRACT_STOREFRONT2=0x4eb8a10cb9f87357
MIX_CONTRACT_DUC=0xead892083b3e2c6c
MIX_TOKEN_FORWARDING=0xe544175ee0461c4b
MIX_DAPPER_MERCHANT=0x8a86f18e0e05bd9f
MIX_HYBRID_CUSTODY=0xd8a7e05a7ac670c0
MIX_CONTRACT_FLOW=0x921ea449dffec68a
MIX_FLOW_NETWORK=mainnet

DAPPER_ENABLED=true
DUST_ENABLED=false

FLOW_MARKET_ADDRESS=
FLOW_ADDRESS=
FLOW_PRIVATE_KEY=
FLOW_MIN_BLOCK_HEIGHT=

# Directory of the flow binary (absolute path, ~ is not expanded)
FLOW_PATH=/home/forge/.local/bin
FLOW_NETWORK=
FLOW_SIGNER=

# Shared secret required by POST /graffle (configure the same value in the Graffle webhook)
GRAFFLE_WEBHOOK_SECRET=
# Graffle is dead since 2026-02; /graffle is only registered when true
GRAFFLE_WEBHOOK_ENABLED=false

# Built-in Flow event indexer (flow:stream daemon + flow:catchup every 5 min + flow:process)
FLOW_REST_URL=https://rest-mainnet.onflow.org
FLOW_WS_URL=wss://rest-mainnet.onflow.org/v1/ws
FLOW_INDEXER_ENABLED=true
FLOW_INDEXER_START_HEIGHT=
FLOW_INDEXER_RPS=20
FLOW_INDEXER_MAX_BLOCKS=25000
FLOW_TIMEOUT=120

# Relaunch feature flags
FLOVATAR_PACK_SALES_ENABLED=false
FLOVATAR_PACK_SALES_NOTICE=
FLOVATAR_IMAGE_EXPORT_ENABLED=false
FLOVATAR_IMAGES_URL=https://images.flovatar.com
FLOVATAR_IMAGE_PROXY=redirect
# Incident 2026-11-16 (comma separated)
FLOVATAR_BLOCKED_ADDRESSES=0x0c7deb7a0c9cb424
# Optional: comma separated origins accepted for wallet account-proof login (default: APP_URL origin)
FLOVATAR_ACCOUNT_PROOF_ORIGINS=

FLOVATAR_PRICE=9.00
FLOVATAR_PRICE_2=35.00

FLOVATAR_LIVE=true
FLOVATAR_WHITELIST=false
FLOVATAR_LAUNCHED=true
FLOBIT_SALE_ENABLED=true

BASE_3D_HOME_PATH=
COMBINER_FOLDER=

MOONPAY_DOMAIN=
MOONPAY_URL=
MOONPAY_PARAMS=
MOONPAY_PUBLIC_KEY=
MOONPAY_SECRET_KEY=

TWITTER_URL=
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_API_TOKEN=
TWITTER_API_SECRET=
TWITTER_API_VERSION=
TWITTER_BEARER_TOKEN=

QUEUEIT_ID=
QUEUEIT_SECRET=
QUEUEIT_API_KEY=
QUEUEIT_URL=

DISCORD_URL=
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_PERMISSION_INTEGER=

PRODIGI_MERCHANT_ID=
PRODIGI_API_KEY=

SENDER_MAIL_TOKEN=
SENDER_MAIL_URL=

CLOUDFLARE_IMAGES_ACCOUNT=
CLOUDFLARE_IMAGES_KEY=
CLOUDFLARE_IMAGES_DELIVERY_URL=
CLOUDFLARE_IMAGES_DEFAULT_VARIATION=

CLOUDINARY_URL=
CLOUDINARY_UPLOAD_PRESET=

OPENAI_API_KEY=
OPENAI_ORGANIZATION=
ELEVEN_API_KEY=
